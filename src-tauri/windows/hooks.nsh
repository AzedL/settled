; Safely adds/removes $INSTDIR from User PATH (HKCU\Environment\Path) without
; NSIS 1024-char truncation, preserving REG_EXPAND_SZ entries and broadcasting
; WM_SETTINGCHANGE so new terminals pick up `settled` immediately.

!macro NSIS_HOOK_POSTINSTALL
  System::Call 'Kernel32::SetEnvironmentVariable(t "SETTLED_INSTALL_DIR", t "$INSTDIR")'
  nsExec::ExecToLog `powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$$d = $$env:SETTLED_INSTALL_DIR; if (-not $$d) { exit 0 }; $$n = $$d.TrimEnd('\').ToLowerInvariant(); $$k = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Environment', $$true); if (-not $$k) { exit 0 }; try { $$raw = [string]$$k.GetValue('Path', '', [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames); $$p = @($$raw -split ';' | Where-Object { $$_.Trim() -ne '' }); $$has = $$false; foreach ($$x in $$p) { if ($$x.Trim().TrimEnd('\').ToLowerInvariant() -eq $$n) { $$has = $$true; break } }; if (-not $$has) { $$k.SetValue('Path', (($$p + $$d) -join ';'), [Microsoft.Win32.RegistryValueKind]::ExpandString); Add-Type -Namespace Settled -Name Native -MemberDefinition '[DllImport(\"user32.dll\", SetLastError=true, CharSet=CharSet.Auto)] public static extern IntPtr SendMessageTimeout(IntPtr hWnd, uint Msg, UIntPtr wParam, string lParam, uint fuFlags, uint uTimeout, out UIntPtr lpdwResult);'; $$r = [UIntPtr]::Zero; [void][Settled.Native]::SendMessageTimeout([IntPtr]0xffff, 0x001A, [UIntPtr]::Zero, 'Environment', 2, 5000, [ref]$$r) } } finally { $$k.Close() }"`
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  System::Call 'Kernel32::SetEnvironmentVariable(t "SETTLED_INSTALL_DIR", t "$INSTDIR")'
  nsExec::ExecToLog `powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$$d = $$env:SETTLED_INSTALL_DIR; if (-not $$d) { exit 0 }; $$n = $$d.TrimEnd('\').ToLowerInvariant(); $$k = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Environment', $$true); if (-not $$k) { exit 0 }; try { $$raw = [string]$$k.GetValue('Path', '', [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames); $$p = @($$raw -split ';' | Where-Object { $$_.Trim() -ne '' }); $$kept = @($$p | Where-Object { $$_.Trim().TrimEnd('\').ToLowerInvariant() -ne $$n }); if ($$kept.Count -ne $$p.Count) { $$k.SetValue('Path', ($$kept -join ';'), [Microsoft.Win32.RegistryValueKind]::ExpandString); Add-Type -Namespace Settled -Name Native -MemberDefinition '[DllImport(\"user32.dll\", SetLastError=true, CharSet=CharSet.Auto)] public static extern IntPtr SendMessageTimeout(IntPtr hWnd, uint Msg, UIntPtr wParam, string lParam, uint fuFlags, uint uTimeout, out UIntPtr lpdwResult);'; $$r = [UIntPtr]::Zero; [void][Settled.Native]::SendMessageTimeout([IntPtr]0xffff, 0x001A, [UIntPtr]::Zero, 'Environment', 2, 5000, [ref]$$r) } } finally { $$k.Close() }"`
!macroend
